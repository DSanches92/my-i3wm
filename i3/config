# i3 config - minimal, vim-like, refined
# Font
font pango:GeistMono Nerd Font 11

# Mod key (SUPER)
set $mod Mod4

# Borders
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Cores (Catppuccin Macchiato)
set $rosewater #f4dbd6
set $flamingo  #f0c6c6
set $pink      #f5bde6
set $mauve     #c6a0f6
set $red       #ed8796
set $maroon    #ee99a0
set $peach     #f5a97f
set $yellow    #eed49f
set $green     #a6da95
set $teal      #8bd5ca
set $sky       #91d7e3
set $sapphire  #7dc4e4
set $blue      #8aadf4
set $lavender  #b7bdf8
set $text      #cad3f5
set $subtext1  #b8c0e0
set $subtext0  #a5adcb
set $overlay2  #939ab7
set $overlay1  #8087a2
set $overlay0  #6e738d
set $surface2  #5b6078
set $surface1  #494d64
set $surface0  #363a4f
set $base      #24273a
set $mantle    #1e2030
set $crust     #181926

# class                 border    background text      indicator  child_border
client.focused          $mauve    $base      $text     $rosewater $mauve
client.focused_inactive $overlay0 $base      $text     $rosewater $surface1
client.unfocused        $overlay0 $base      $subtext1 $rosewater $surface0
client.urgent           $red      $base      $text     $rosewater $red
client.placeholder      $overlay0 $base      $text     $rosewater $surface0
client.background       $base

# Configuração da Barra (i3bar)
bar {
  font pango:GeistMono Nerd Font 11
  status_command i3status
  position bottom

  colors {
    background          $base
    statusline          $text
    separator           $mauve

    # Tipo de janela    borda     fundo     texto
    focused_workspace   $mauve    $surface0 $mauve
    active_workspace    $surface2 $base     $text
    inactive_workspace  $base     $base     $subtext1
    urgent_workspace    $red      $base     $red
    binding_mode        $red      $base     $red
  }
}

# Workspaces
set $ws1 "1:web"
set $ws2 "2:term"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

# Start
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock-color -c 1e1e2e
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id picom -b
exec --no-startup-id dunst
exec --no-startup-id polybar main &
exec --no-startup-id feh --bg-fill ~/.config/wallpaper.jpeg 2>/dev/null || true
exec --no-startup-id /usr/lib/mate-polkit/polkit-mate-authentication-agent-1
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY
exec --no-startup-id setxkbmap -layout br -model abnt2
exec --no-startup-id ~/.config/i3/anti-sleep.sh

# Focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split
bindsym $mod+v split vertical
bindsym $mod+h split horizontal

# Layouts
bindsym $mod+Shift+s layout stacking
bindsym $mod+Shift+t layout tabbed
bindsym $mod+Shift+w layout toggle split

# Floating / Fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+f fullscreen toggle
bindsym $mod+space focus mode_toggle

# Resize mode
mode "resize" {
    bindsym Left resize shrink width 5 px or 5 ppt
    bindsym Down resize grow height 5 px or 5 ppt
    bindsym Up resize shrink height 5 px or 5 ppt
    bindsym Right resize grow width 5 px or 5 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Workspaces
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Apps
bindsym $mod+Return exec alacritty
bindsym $mod+d exec --no-startup-id ~/.config/dmenu/dmenu-run.sh
bindsym $mod+p exec --no-startup-id ~/.config/dmenu/passmenu-run.sh
bindsym $mod+e exec thunar
bindsym $mod+Shift+e exec --no-startup-id alacritty -e yazi
bindsym $mod+q kill
bindsym $mod+Shift+r reload
bindsym $mod+b exec firefox
bindsym $mod+s exec steam

# Screenshot
bindsym Print exec flameshot gui
bindsym $mod+Print exec flameshot full -p ~/Pictures

# Volume knob / XF86
bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 2 && notify-send -t 800 "Vol +" "$(pamixer --get-volume)%"
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 2 && notify-send -t 800 "Vol -" "$(pamixer --get-volume)%"
bindsym XF86AudioMute exec --no-startup-id pamixer -t && notify-send -t 800 "Mute" "$(pamixer --get-mute && echo ON || echo OFF)"
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# Floating rules
for_window [class="Pavucontrol"] floating enable, move position center
for_window [class="Blueman-manager"] floating enable, move position center
for_window [class="Nm-connection-editor"] floating enable, move position center
for_window [class="Lxappearance"] floating enable, move position center
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [class="feh"] floating enable
for_window [class="mpv"] floating enable
for_window [class="Thunar"] floating enable

# Workspace assignments
assign [class="firefox"] $ws1
assign [class="Alacritty"] $ws2
